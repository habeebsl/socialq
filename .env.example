# socialq — local secrets. Gitignored; never commit this file.
# Fill in the values on the right of each '=

# --- Cloudflare R2 (§9) -----------------------------------------------------
# R2 overview page, right-hand sidebar (also the hex string in the dashboard URL)
R2_ACCOUNT_ID=

# R2 -> Manage API tokens -> Create token -> Object Read & Write, scoped to the
# one bucket. The secret is shown once; copy it then.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Whatever you named the bucket, e.g. socialq-media
R2_BUCKET=

# Settings -> Public access -> Custom domains. No trailing slash.
# An r2.dev URL is refused on purpose: rate-limited, not for production.
R2_PUBLIC_BASE_URL=

# --- Postgres ---------------------------------------------------------------
# Not needed yet: tests use the local Docker container (see CONTRIBUTING.md).
# This is the real database, once we deploy to Modal.
DATABASE_URL=

# --- Instagram Graph (§8.3) — step 3, fill in later --------------------------
# Business or Creator account, via Instagram Login (not the Facebook-Login route).
# Scopes: instagram_business_basic, instagram_business_content_publish.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- PostPeer (§8.2) — step 4, fill in later ---------------------------------
# Three free accounts, rotated (§8.2.1). The key and the accountId are a pair:
# each account's TikTok integration id is meaningless to the other two.
POSTPEER_API_KEY_1=
POSTPEER_TIKTOK_ACCOUNT_ID_1=
POSTPEER_API_KEY_2=
POSTPEER_TIKTOK_ACCOUNT_ID_2=
POSTPEER_API_KEY_3=
POSTPEER_TIKTOK_ACCOUNT_ID_3=
